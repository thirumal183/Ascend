# ==============================================================================
# ASCEND Backend Environment Variables (Reference Template)
# Copy this file to backend/.env for local development.
# NEVER commit .env or real credentials to version control.
# ==============================================================================

# Application Meta
PROJECT_NAME="ASCEND Nutrition & Fitness Platform"
VERSION="1.0.0"
# Use "development" locally; "production" on hosted environments (enforces DEBUG=False & strong SECRET_KEY)
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL 16+ via asyncpg)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password_here"
POSTGRES_DB="ascend_db"

# Optional explicit connection URI (overrides individual parameters above if provided)
# Example (Neon production): postgresql://user:pass@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL="postgresql+asyncpg://postgres:your_postgres_password_here@localhost:5432/ascend_db"

# Database Connection Pool & Timeout Settings
# For free-tier Render + Neon, recommended: POOL_SIZE=5, MAX_OVERFLOW=5, POOL_RECYCLE=300
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_PRE_PING=True
DATABASE_POOL_RECYCLE=300
DATABASE_CONNECT_TIMEOUT=10.0
DATABASE_COMMAND_TIMEOUT=15.0

# Request & Security Controls
MAX_REQUEST_BODY_BYTES=1048576
RATE_LIMIT_ENABLED=True

# Cryptographic JWT Signing Key (MUST be >= 32 random chars in staging/production)
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="replace-with-a-cryptographically-secure-random-256-bit-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cross-Origin Resource Sharing (CORS)
# Allowed frontend client origins (JSON array or comma-separated list)
# In production, set to your exact Cloudflare Pages URL, e.g.: ["https://ascend-app.pages.dev"]
BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000"]'

# AI & Gemini API Configuration (Server-side ONLY; falls back to local heuristic engine if omitted)
# GEMINI_API_KEY="your_google_gemini_api_key_here"
# GEMINI_MODEL="gemini-2.5-flash"
# AI_REQUEST_TIMEOUT_SECONDS=10.0

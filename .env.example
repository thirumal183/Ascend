# ==============================================================================
# ASCEND Frontend Environment Variables (Reference Template)
# Vite exposes ONLY variables prefixed with VITE_ to browser bundles.
# NEVER place GEMINI_API_KEY, SECRET_KEY, or database credentials in VITE_* vars.
# ==============================================================================

# Base URL of the FastAPI backend API (including /api/v1)
# Local dev default: http://localhost:8000/api/v1
# Production example (Render): https://ascend-api.onrender.com/api/v1
VITE_API_BASE_URL="http://localhost:8000/api/v1"
